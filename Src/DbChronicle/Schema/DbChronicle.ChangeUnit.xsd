<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      DbChronicle 逻辑模型（变更单元）XML Schema。
      用于编辑器补全与即时校验；语义校验（重复 ADD、DROP 不存在列、跨单元依赖、方言能力）由 db-chronicle check 完成。
      元素顺序不敏感：同一父节点下子元素可任意顺序、可重复出现。
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="BooleanLiteral">
    <xs:annotation>
      <xs:documentation>布尔字面量：true / false。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="true">
        <xs:annotation>
          <xs:documentation>真：布尔或位类型取真值。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="false">
        <xs:annotation>
          <xs:documentation>假：布尔或位类型取假值。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ChangeId">
    <xs:annotation>
      <xs:documentation>变更单元 id：8 位日期开头，通常为 yyyyMMdd_HHmmss_短哈希；必须与文件名前缀一致。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{8}(_[A-Za-z0-9_.-]+)*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Release">
    <xs:annotation>
      <xs:documentation>发布版本：8 位日期 yyyyMMdd；基线固定 00000000；不得晚于当前日期 + 1 天。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{8}" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonEmptyString">
    <xs:annotation>
      <xs:documentation>非空文本：至少要有一个非空白字符；纯空格、空串都算无效（元素内容允许换行与缩进）。用于必填名称、SQL 片段与视图查询。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[\s\S]*\S[\s\S]*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Identifier">
    <xs:annotation>
      <xs:documentation>ASCII 标识符：字母开头，只含字母、数字与下划线。字符集、排序规则、存储引擎、表空间等取值都属于这类数据库关键字，不接受纯数字、中文、空格或连字符。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:NCName">
      <xs:pattern value="[A-Za-z][A-Za-z0-9_]*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IncrementValue">
    <xs:annotation>
      <xs:documentation>序列步长：整数且不能为 0（INCREMENT BY 0 在 PostgreSQL / SQL Server 是非法 DDL）。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:long">
      <xs:pattern value="[+-]?[0-9]*[1-9][0-9]*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ColumnReference">
    <xs:annotation>
      <xs:documentation>列级外键引用：必须写成 表名.列名（恰好一个点号，两端非空，不能有空格），与解析阶段的 E031 一致。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[^.\s]+(\.[^.\s]+)" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DialectName">
    <xs:annotation>
      <xs:documentation>方言名：只允许这六种，写错会导致该段 SQL 被当成缺当前方言而跳过（W032）。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="mysql">
        <xs:annotation>
          <xs:documentation>MySQL：按 database.version 选择 5.7 / 8.0 语法差异。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="mariadb">
        <xs:annotation>
          <xs:documentation>MariaDB：默认按 10.5 处理。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="postgresql">
        <xs:annotation>
          <xs:documentation>PostgreSQL：配置里的 pgsql 是它的别名，此处必须写 postgresql。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="sqlserver">
        <xs:annotation>
          <xs:documentation>SQL Server。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="sqlite">
        <xs:annotation>
          <xs:documentation>SQLite：结构受限，很多操作需要重建表。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="any">
        <xs:annotation>
          <xs:documentation>所有方言通用：当前方言缺专用片段时回退到它。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CommonCharset">
    <xs:annotation>
      <xs:documentation>常见字符集：给出候选便于补全；实际校验只要求是 ASCII 标识符，自定义字符集不会被误报。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="utf8mb4">
        <xs:annotation>
          <xs:documentation>四字节 UTF-8：支持 emoji 与生僻字，MySQL 8.0 默认，新项目首选。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8">
        <xs:annotation>
          <xs:documentation>MySQL 里是三字节 UTF-8 的历史别名（等同 utf8mb3），不支持四字节字符。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8mb3">
        <xs:annotation>
          <xs:documentation>三字节 UTF-8：不支持四字节字符，建议改用 utf8mb4。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="gbk">
        <xs:annotation>
          <xs:documentation>简体中文双字节编码：兼容 GBK。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="gb18030">
        <xs:annotation>
          <xs:documentation>简体中文四字节编码：GB18030 全集。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="gb2312">
        <xs:annotation>
          <xs:documentation>简体中文基础字符集：只覆盖 GB2312。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="big5">
        <xs:annotation>
          <xs:documentation>繁体中文编码。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="latin1">
        <xs:annotation>
          <xs:documentation>西欧单字节编码：MySQL 的 latin1 实际是 cp1252。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ascii">
        <xs:annotation>
          <xs:documentation>七位 ASCII：只能存 0-127。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="binary">
        <xs:annotation>
          <xs:documentation>二进制字符集：按字节比较，不做字符集转换。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CharsetName">
    <xs:annotation>
      <xs:documentation>字符集名：常见值可直接选，也接受其它 ASCII 标识符。</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="CommonCharset Identifier" />
  </xs:simpleType>

  <xs:simpleType name="CommonCollation">
    <xs:annotation>
      <xs:documentation>常见排序规则：给出候选便于补全；实际校验只要求是 ASCII 标识符，未列出的排序规则不会被误报。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="utf8mb4_general_ci">
        <xs:annotation>
          <xs:documentation>utf8mb4 通用排序规则：不区分大小写，MySQL 5.7 默认。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8mb4_unicode_ci">
        <xs:annotation>
          <xs:documentation>utf8mb4 Unicode 排序规则：按 Unicode 规则排序，不区分大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8mb4_0900_ai_ci">
        <xs:annotation>
          <xs:documentation>utf8mb4 的 UCA 9.0.0 排序规则：不区分重音与大小写，MySQL 8.0 默认。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8mb4_0900_as_cs">
        <xs:annotation>
          <xs:documentation>utf8mb4 的 UCA 9.0.0 排序规则：区分重音与大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8mb4_bin">
        <xs:annotation>
          <xs:documentation>utf8mb4 二进制比较：按字节比较，区分大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8_general_ci">
        <xs:annotation>
          <xs:documentation>utf8（三字节）通用排序规则：不区分大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8_unicode_ci">
        <xs:annotation>
          <xs:documentation>utf8（三字节）Unicode 排序规则：不区分大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="utf8_bin">
        <xs:annotation>
          <xs:documentation>utf8（三字节）二进制比较：区分大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="gbk_chinese_ci">
        <xs:annotation>
          <xs:documentation>GBK 中文排序规则：不区分大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="gb18030_chinese_ci">
        <xs:annotation>
          <xs:documentation>GB18030 中文排序规则：不区分大小写。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="latin1_swedish_ci">
        <xs:annotation>
          <xs:documentation>latin1 瑞典语排序规则：MySQL 5.7 默认。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="binary">
        <xs:annotation>
          <xs:documentation>二进制排序规则：与 BINARY 字符集配对，按字节比较。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CollationName">
    <xs:annotation>
      <xs:documentation>排序规则名：常见值可直接选，也接受其它 ASCII 标识符（写成数字、中文或空格会报错）。</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="CommonCollation Identifier" />
  </xs:simpleType>

  <xs:simpleType name="StorageEngine">
    <xs:annotation>
      <xs:documentation>MySQL / MariaDB 存储引擎：给出候选便于补全；实际校验只要求是 ASCII 标识符，插件式引擎不会被误报。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="InnoDB">
        <xs:annotation>
          <xs:documentation>事务型引擎：支持外键、行锁与崩溃恢复，MySQL 5.5 起默认。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MyISAM">
        <xs:annotation>
          <xs:documentation>非事务引擎：表级锁，不支持外键与事务。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEMORY">
        <xs:annotation>
          <xs:documentation>内存引擎：数据在内存中，重启即丢失。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARCHIVE">
        <xs:annotation>
          <xs:documentation>归档引擎：只写压缩存储，不支持索引与更新。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CSV">
        <xs:annotation>
          <xs:documentation>CSV 引擎：以文本文件存储，不支持索引与事务。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLACKHOLE">
        <xs:annotation>
          <xs:documentation>黑洞引擎：写入即丢弃，常用于复制中继。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRG_MyISAM">
        <xs:annotation>
          <xs:documentation>MERGE 引擎：把多个结构相同的 MyISAM 表合成一个逻辑表。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FEDERATED">
        <xs:annotation>
          <xs:documentation>联邦引擎：代理访问远端 MySQL 表。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NDB">
        <xs:annotation>
          <xs:documentation>NDB 引擎：MySQL Cluster 使用。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EngineName">
    <xs:annotation>
      <xs:documentation>存储引擎名：常见值可直接选，也接受其它 ASCII 标识符。</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="StorageEngine Identifier" />
  </xs:simpleType>

  <xs:simpleType name="LogicalType">
    <xs:annotation>
      <xs:documentation>逻辑类型（区分大小写）。禁止写物理类型（VARCHAR / TINYINT 等）。String / FixedString / Binary 必须同时给 length。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Boolean">
        <xs:annotation>
          <xs:documentation>布尔：映射 TINYINT(1)、BOOLEAN 或 BIT。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Int8">
        <xs:annotation>
          <xs:documentation>8 位有符号整数：映射 TINYINT。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Int16">
        <xs:annotation>
          <xs:documentation>16 位有符号整数：映射 SMALLINT。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Int32">
        <xs:annotation>
          <xs:documentation>32 位有符号整数：映射 INT / INTEGER。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Int64">
        <xs:annotation>
          <xs:documentation>64 位有符号整数：映射 BIGINT。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Float32">
        <xs:annotation>
          <xs:documentation>32 位浮点数：映射 FLOAT / REAL。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Float64">
        <xs:annotation>
          <xs:documentation>64 位浮点数：映射 DOUBLE / DOUBLE PRECISION。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Decimal">
        <xs:annotation>
          <xs:documentation>定点小数：映射 DECIMAL / NUMERIC，配合 precision 与 scale。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FixedString">
        <xs:annotation>
          <xs:documentation>定长字符串：映射 CHAR(n)，必须同时给 length。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="String">
        <xs:annotation>
          <xs:documentation>变长字符串：映射 VARCHAR(n)，必须同时给 length。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Text">
        <xs:annotation>
          <xs:documentation>长文本：映射 TEXT / CLOB，不需要 length。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Json">
        <xs:annotation>
          <xs:documentation>JSON 文本：映射 JSON / JSONB，方言支持程度不同。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Xml">
        <xs:annotation>
          <xs:documentation>XML 文本：映射 XML 或 TEXT，方言支持程度不同。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DateTime">
        <xs:annotation>
          <xs:documentation>日期时间（无时区）：映射 DATETIME / TIMESTAMP。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DateTimeOffset">
        <xs:annotation>
          <xs:documentation>带时区偏移的日期时间：PostgreSQL 映射 TIMESTAMPTZ、SQL Server 映射 DATETIMEOFFSET；MySQL / MariaDB 降级为 TIMESTAMP（W003，不保留偏移），SQLite 映射 TEXT。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Date">
        <xs:annotation>
          <xs:documentation>日期：映射 DATE。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Time">
        <xs:annotation>
          <xs:documentation>时间：映射 TIME。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Binary">
        <xs:annotation>
          <xs:documentation>定长二进制：映射 BINARY(n)，必须同时给 length。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Blob">
        <xs:annotation>
          <xs:documentation>二进制大对象：映射 BLOB / BYTEA / IMAGE。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Uuid">
        <xs:annotation>
          <xs:documentation>UUID / GUID：映射 UUID / UNIQUEIDENTIFIER。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TableAction">
    <xs:annotation>
      <xs:documentation>表级动作（解析大小写不敏感，推荐大写）。CREATE/ALTER 使用列与约束子节点；RENAME 需要 newName；ENGINE/CHARSET/TABLESPACE 需要 engine/charset/collate/tablespace 至少一项。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="CREATE">
        <xs:annotation>
          <xs:documentation>新建表：使用 column / constraint 等子节点定义结构。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ALTER">
        <xs:annotation>
          <xs:documentation>修改表：使用 column / index / primaryKey / foreignKey 等子节点描述变更。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DROP">
        <xs:annotation>
          <xs:documentation>删除表：只写 name；会直接生成 DROP TABLE 语句。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RENAME">
        <xs:annotation>
          <xs:documentation>重命名表：需要 newName。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COMMENT">
        <xs:annotation>
          <xs:documentation>修改表注释：配合 comment 使用。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REBUILD">
        <xs:annotation>
          <xs:documentation>重建表：按 ALTER 处理（W018），SQLite 在需要时自动 rebuild，其他方言请改用 &lt;rawSql&gt;。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ENGINE">
        <xs:annotation>
          <xs:documentation>修改存储引擎：MySQL / MariaDB，配合 engine。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHARSET">
        <xs:annotation>
          <xs:documentation>修改字符集或排序规则：MySQL / MariaDB，配合 charset 与 collate。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TABLESPACE">
        <xs:annotation>
          <xs:documentation>修改表空间：PostgreSQL 等，配合 tablespace。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ColumnAction">
    <xs:annotation>
      <xs:documentation>列级动作（缺省 ADD）。MODIFY 在 incrementalModify=true 时只写变化项，full 模式必须写 type 与 nullable；RENAME 需要 renamedFrom；REORDER 需要 after（仅 MySQL/MariaDB，其余方言报 E044）。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ADD">
        <xs:annotation>
          <xs:documentation>新增列：必须给 name，并通常给 type；String / FixedString / Binary 还要给 length。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MODIFY">
        <xs:annotation>
          <xs:documentation>修改列：incrementalModify=true 时只写变化项；full 模式必须写 type 与 nullable。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DROP">
        <xs:annotation>
          <xs:documentation>删除列：会直接生成 DROP COLUMN 语句。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RENAME">
        <xs:annotation>
          <xs:documentation>重命名列：需要 renamedFrom。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COMMENT">
        <xs:annotation>
          <xs:documentation>修改列注释：配合 comment 使用。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REORDER">
        <xs:annotation>
          <xs:documentation>调整列顺序：需要 after；仅 MySQL / MariaDB，其余方言报 E044。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ObjectAction">
    <xs:annotation>
      <xs:documentation>对象（索引 / 主键 / 唯一 / 检查 / 默认值 / 外键 / 视图 / 序列）动作（缺省 ADD）。DROP 只写 name；RENAME 需要 newName。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ADD">
        <xs:annotation>
          <xs:documentation>新增对象：索引、主键、唯一约束、检查约束、默认值、外键等。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CREATE">
        <xs:annotation>
          <xs:documentation>创建对象：视图、序列、触发器、存储过程、函数等。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DROP">
        <xs:annotation>
          <xs:documentation>删除对象：只写 name，会直接生成 DROP 语句。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RENAME">
        <xs:annotation>
          <xs:documentation>重命名对象：需要 newName。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REPLACE">
        <xs:annotation>
          <xs:documentation>创建或替换对象：视图、存储过程、函数等。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MODIFY">
        <xs:annotation>
          <xs:documentation>修改对象定义：如修改视图查询、过程体等。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COMMENT">
        <xs:annotation>
          <xs:documentation>修改对象注释：配合 comment 使用。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Stage">
    <xs:annotation>
      <xs:documentation>数据操作时机：before = 所有结构变更之前（只能引用变更前已存在的表列）；after（缺省）= 该表结构变更之后。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="before">
        <xs:annotation>
          <xs:documentation>在所有结构变更之前执行；只能引用变更前已存在的表列。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="after">
        <xs:annotation>
          <xs:documentation>在该表结构变更之后执行（缺省）。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ReferentialAction">
    <xs:annotation>
      <xs:documentation>外键级联动作（原样传给方言，取值 CASCADE / SET NULL / RESTRICT / NO ACTION / SET DEFAULT）。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="CASCADE">
        <xs:annotation>
          <xs:documentation>级联：父记录删除或更新时，同时删除或更新子表记录。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SET NULL">
        <xs:annotation>
          <xs:documentation>置空：父记录删除或更新时，把子表外键列置为 NULL。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RESTRICT">
        <xs:annotation>
          <xs:documentation>限制：存在子记录时拒绝删除或更新父记录。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NO ACTION">
        <xs:annotation>
          <xs:documentation>不执行动作：由数据库在语句结束时检查外键约束。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SET DEFAULT">
        <xs:annotation>
          <xs:documentation>置默认值：父记录删除或更新时，把子表外键列置为默认值。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SeedConflict">
    <xs:annotation>
      <xs:documentation>种子数据冲突策略：IGNORE / UPDATE；缺省为普通 INSERT。SQL Server 不支持，降级并告警 W029。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="IGNORE">
        <xs:annotation>
          <xs:documentation>冲突时忽略新行：INSERT IGNORE / ON CONFLICT DO NOTHING。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UPDATE">
        <xs:annotation>
          <xs:documentation>冲突时更新已有行：ON DUPLICATE KEY UPDATE / ON CONFLICT DO UPDATE。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IndexKind">
    <xs:annotation>
      <xs:documentation>索引类型：NORMAL / UNIQUE / FULLTEXT / SPATIAL（原样传给方言，方言不支持时报错或告警）。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="NORMAL">
        <xs:annotation>
          <xs:documentation>普通索引：不要求唯一。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNIQUE">
        <xs:annotation>
          <xs:documentation>唯一索引：索引列组合不允许重复值。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FULLTEXT">
        <xs:annotation>
          <xs:documentation>全文索引：用于文本检索，方言支持程度不同。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPATIAL">
        <xs:annotation>
          <xs:documentation>空间索引：用于地理/几何类型，方言支持程度不同。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConstraintKind">
    <xs:annotation>
      <xs:documentation>约束种类：用于定位约束注释的目标对象。</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="primaryKey">
        <xs:annotation>
          <xs:documentation>主键约束。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="unique">
        <xs:annotation>
          <xs:documentation>唯一约束。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="check">
        <xs:annotation>
          <xs:documentation>检查约束。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="foreignKey">
        <xs:annotation>
          <xs:documentation>外键约束。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="default">
        <xs:annotation>
          <xs:documentation>默认值约束。</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="DialectSqlType">
    <xs:annotation>
      <xs:documentation>按方言的 SQL 片段：dialect 取 mysql / mariadb / postgresql / sqlserver / sqlite，any 或缺省表示所有方言通用。sql 文本不能为空（纯空白也算空），长脚本建议用 CDATA。</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="NonEmptyString">
        <xs:attribute name="dialect" type="DialectName">
          <xs:annotation>
            <xs:documentation>方言名（mysql / mariadb / postgresql / sqlserver / sqlite / any）。缺省为 any。</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="DependsType">
    <xs:annotation>
      <xs:documentation>显式依赖的变更单元 id。补丁文件必须声明 depends；依赖只做存在性与顺序校验，不改变物理执行顺序。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="on" type="ChangeId" use="required">
      <xs:annotation>
        <xs:documentation>被依赖的变更单元 id。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ColumnRefType">
    <xs:annotation>
      <xs:documentation>列引用：用于索引 / 主键 / 唯一约束 / 外键的列清单。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>列名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ColumnType">
    <xs:annotation>
      <xs:documentation>列定义 / 列操作。CREATE 表内必须给 type（String / FixedString / Binary 还要 length）；ALTER 表内 action 缺省 ADD。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>列名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ColumnAction" default="ADD">
      <xs:annotation>
        <xs:documentation>列级动作，缺省 ADD：ADD / MODIFY / DROP / RENAME / COMMENT / REORDER。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="LogicalType">
      <xs:annotation>
        <xs:documentation>逻辑类型（不是物理类型）。ADD 必填；MODIFY 在 full 模式下必填。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="length" type="xs:positiveInteger">
      <xs:annotation>
        <xs:documentation>长度：正整数。String / FixedString / Binary 必填；Blob 写了会被忽略并告警 W005。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="precision" type="xs:positiveInteger">
      <xs:annotation>
        <xs:documentation>精度：正整数，Decimal 使用。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation>小数位：非负整数，Decimal 使用，不能大于 precision。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="nullable" type="BooleanLiteral">
      <xs:annotation>
        <xs:documentation>是否可空。incrementalModify=true 时不写表示保持原值；full 模式必须显式声明。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="primaryKey" type="BooleanLiteral">
      <xs:annotation>
        <xs:documentation>是否主键。SQLite 的 ADD 列不支持，需走 rebuild。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoIncrement" type="BooleanLiteral">
      <xs:annotation>
        <xs:documentation>是否自增。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unique" type="BooleanLiteral">
      <xs:annotation>
        <xs:documentation>是否唯一；MySQL / MariaDB / PostgreSQL / SQL Server / SQLite 的列定义都会生成内联 UNIQUE（若要命名或建复合唯一约束请用 &lt;uniqueConstraint&gt;）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unsigned" type="BooleanLiteral">
      <xs:annotation>
        <xs:documentation>是否无符号（仅整数类型有效，仅 MySQL/MariaDB 生效）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="defaultValue" type="xs:string">
      <xs:annotation>
        <xs:documentation>默认值：null = 显式 NULL；'' = 空字符串；none = 删除默认值；CURRENT_TIMESTAMP 等函数形态原样透传。省略的含义由 incrementalModify 决定（true 保持原值 / false 目标无默认值）。字面量须与 type 匹配：数值列只能写数字，Boolean 只能写 true / false，否则解析报 E060（XSD 1.0 无法表达这种跨属性约束，由 check / compile 阶段校验）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment" type="xs:string">
      <xs:annotation>
        <xs:documentation>列注释；COMMENT 动作必填。PostgreSQL / SQL Server 支持；MySQL 需要完整列定义，否则跳过并告警 W007；SQLite 不支持，跳过并告警 W007。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="onUpdate" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>更新时刷新值（如 CURRENT_TIMESTAMP），仅 DateTime / DateTimeOffset 有效，仅 MySQL/MariaDB 生效。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="charset" type="CharsetName">
      <xs:annotation>
        <xs:documentation>列字符集（MySQL/MariaDB）：常见字符集可直接选，也接受其它 ASCII 标识符。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="collate" type="CollationName">
      <xs:annotation>
        <xs:documentation>列排序规则（MySQL/MariaDB）：常见排序规则可直接选，也接受其它 ASCII 标识符；数字、中文、空格会报错。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="foreignKey" type="ColumnReference">
      <xs:annotation>
        <xs:documentation>列级外键引用，格式必须是 表名.列名（例如 nor_dept.id）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="renamedFrom" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>重命名前的列名，action=RENAME 时必填。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="after" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>列顺序位置（列名或 FIRST），action=REORDER 时使用；不支持 before，仅 MySQL/MariaDB 生效。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>仅数据类列操作有意义：before / after（缺省 after）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="IndexType">
    <xs:annotation>
      <xs:documentation>索引。列清单可写 columns="a,b"，也可用 &lt;columnRef name="a"/&gt; 子节点。DROP/RENAME 只写 name（RENAME 需 newName）。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="columnRef" type="ColumnRefType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>索引名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>索引动作，缺省 ADD。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="newName" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>重命名后的索引名，action=RENAME 时必填。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unique" type="BooleanLiteral" default="false">
      <xs:annotation>
        <xs:documentation>是否唯一索引，缺省 false。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="IndexKind">
      <xs:annotation>
        <xs:documentation>索引类型：NORMAL / UNIQUE / FULLTEXT / SPATIAL。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>列清单，逗号分隔（也可用 columnRef 子节点）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="expression" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>表达式索引（方言支持时使用）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="where" type="xs:string">
      <xs:annotation>
        <xs:documentation>部分索引条件（PostgreSQL / SQLite 支持）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment" type="xs:string">
      <xs:annotation>
        <xs:documentation>索引注释（方言支持时使用）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="PrimaryKeyType">
    <xs:annotation>
      <xs:documentation>表主键。CREATE 表内可替代列上的 primaryKey="true"；ALTER 表内 action 缺省 ADD。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="columnRef" type="ColumnRefType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>主键约束名（可选）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>动作，缺省 ADD。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>主键列清单，逗号分隔。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="UniqueConstraintType">
    <xs:annotation>
      <xs:documentation>唯一约束。列清单用 columns 或 columnRef 子节点。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="columnRef" type="ColumnRefType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>约束名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>动作，缺省 ADD。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>列清单，逗号分隔。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="CheckConstraintType">
    <xs:annotation>
      <xs:documentation>检查约束。ADD 时 expression 必填；SQLite 会走表重建。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>约束名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>动作，缺省 ADD。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="expression" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>检查表达式，例如 age &gt;= 0 AND age &lt;= 150（XML 中 &lt; &gt; &amp; 需转义或写进 CDATA）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="DefaultConstraintType">
    <xs:annotation>
      <xs:documentation>独立默认值约束（SET DEFAULT）：MySQL 8+ / MariaDB / PostgreSQL / SQL Server 支持；MySQL 5.7 告警 W024 并跳过，SQLite 跳过并告警 W025。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>约束名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>动作，缺省 ADD。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="column" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>目标列名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>默认值表达式，原样写入 DDL。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ForeignKeyType">
    <xs:annotation>
      <xs:documentation>外键。ADD 时 refTable 必填；refColumns 与 columns 一一对应。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="columnRef" type="ColumnRefType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>外键名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>动作，缺省 ADD；DROP 时只写 name。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>本表列清单，逗号分隔。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="refTable" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>引用表名（ADD 时必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="refColumns" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>引用列清单，逗号分隔。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="onDelete" type="ReferentialAction">
      <xs:annotation>
        <xs:documentation>删除时动作：CASCADE / SET NULL / RESTRICT / NO ACTION / SET DEFAULT。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="onUpdate" type="ReferentialAction">
      <xs:annotation>
        <xs:documentation>更新时动作：CASCADE / SET NULL / RESTRICT / NO ACTION / SET DEFAULT。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ConstraintCommentType">
    <xs:annotation>
      <xs:documentation>约束注释（PostgreSQL / SQL Server 使用）。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>约束名（必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" type="ConstraintKind">
      <xs:annotation>
        <xs:documentation>约束种类：primaryKey / unique / check / foreignKey / default。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment" type="xs:string">
      <xs:annotation>
        <xs:documentation>注释内容。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="DataMigrationType" mixed="true">
    <xs:annotation>
      <xs:documentation>按方言的数据迁移 SQL。推荐每个 &lt;sql dialect="..."&gt; 一条；也可用 dialect 属性 + 节点内文本 / CDATA 直接写。缺当前方言时告警 W032。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="sql" type="DialectSqlType" />
    </xs:choice>
    <xs:attribute name="dialect" type="DialectName">
      <xs:annotation>
        <xs:documentation>直接写文本时的方言名（mysql / mariadb / postgresql / sqlserver / sqlite）；使用 &lt;sql&gt; 子节点时无需该属性。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。给新增列回填必须用 after，否则列还不存在。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="SeedRowType">
    <xs:annotation>
      <xs:documentation>种子数据行。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="values" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>值列表，与 seed 的 columns 一一对应；字符串用单引号，逗号分隔（引号内的逗号不会被拆分）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="SeedType">
    <xs:annotation>
      <xs:documentation>结构化种子数据。columns 必填；conflict 缺省为普通 INSERT。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="row" type="SeedRowType" />
    </xs:choice>
    <xs:attribute name="columns" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>列清单，逗号分隔（必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="table" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>兼容属性：解析器忽略，实际归属由外层 &lt;table name="..."&gt; 决定。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="conflict" type="SeedConflict">
      <xs:annotation>
        <xs:documentation>冲突策略：IGNORE / UPDATE；缺省为普通 INSERT。SQL Server 不支持冲突策略，降级并告警 W029；UPDATE 在 PostgreSQL 需要主键、SQLite 需要 3.24+ 且主键，条件不满足时降级并告警 W029；IGNORE 不需要主键。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="UpdateType">
    <xs:annotation>
      <xs:documentation>按条件更新数据（UPDATE）。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="set" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>SET 子句，例如 status = 0（必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="where" type="xs:string">
      <xs:annotation>
        <xs:documentation>WHERE 子句；省略表示全表。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="DeleteType">
    <xs:annotation>
      <xs:documentation>按条件删除数据（DELETE）。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="where" type="xs:string">
      <xs:annotation>
        <xs:documentation>WHERE 子句；省略表示全表删除（谨慎）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="CleanType">
    <xs:annotation>
      <xs:documentation>数据清洗：按规则把列置空 / 置默认值。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="rules" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>清洗规则，形如 email = NULL; phone = NULL（必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="where" type="xs:string">
      <xs:annotation>
        <xs:documentation>WHERE 子句；省略表示全表。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="BackfillType">
    <xs:annotation>
      <xs:documentation>回填单列：column 与 value 必填。给本次新增列回填要用 stage="after"。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="column" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>目标列名（必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>回填值原样写入 SQL（必填），例如 0 或 'unknown'。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="where" type="xs:string">
      <xs:annotation>
        <xs:documentation>WHERE 子句；省略表示全表回填。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="TableType">
    <xs:annotation>
      <xs:documentation>表节点。action=CREATE 时子节点定义整表；action=ALTER 时子节点是增量操作；name="*" 表示库中所有表（必须连库执行，可用 tables 限定）。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="column" type="ColumnType" />
      <xs:element name="index" type="IndexType" />
      <xs:element name="primaryKey" type="PrimaryKeyType" />
      <xs:element name="uniqueConstraint" type="UniqueConstraintType" />
      <xs:element name="checkConstraint" type="CheckConstraintType" />
      <xs:element name="defaultConstraint" type="DefaultConstraintType" />
      <xs:element name="foreignKey" type="ForeignKeyType" />
      <xs:element name="constraintComment" type="ConstraintCommentType" />
      <xs:element name="dataMigration" type="DataMigrationType" />
      <xs:element name="seed" type="SeedType" />
      <xs:element name="update" type="UpdateType" />
      <xs:element name="delete" type="DeleteType" />
      <xs:element name="clean" type="CleanType" />
      <xs:element name="backfill" type="BackfillType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>表名（必填）；"*" 表示库中所有业务表。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="TableAction" default="ALTER">
      <xs:annotation>
        <xs:documentation>表级动作，缺省 ALTER。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment" type="xs:string">
      <xs:annotation>
        <xs:documentation>表注释；action=COMMENT 时使用。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="newName" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>新的表名，action=RENAME 时必填。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tables" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>显式表清单，逗号分隔；仅在 name="*" 时有意义（离线也能展开）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="engine" type="EngineName">
      <xs:annotation>
        <xs:documentation>表引擎（仅 MySQL/MariaDB；action=ENGINE 或与 ENGINE/CHARSET 同用）：常见引擎可直接选，也接受其它 ASCII 标识符。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="charset" type="CharsetName">
      <xs:annotation>
        <xs:documentation>表字符集（仅 MySQL/MariaDB；action=CHARSET）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="collate" type="CollationName">
      <xs:annotation>
        <xs:documentation>表排序规则（仅 MySQL/MariaDB）：数字、中文、空格会报错。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tablespace" type="Identifier">
      <xs:annotation>
        <xs:documentation>表空间（PostgreSQL / Oracle 类方言；action=TABLESPACE）：ASCII 标识符。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="RawSqlType" mixed="true">
    <xs:annotation>
      <xs:documentation>原样执行的 SQL：直接写文本（推荐 CDATA），不分析、不分方言。只能作为 &lt;changeUnit&gt; 的直接子节点；空内容报 E051。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="sql" type="DialectSqlType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>归属表名（可选），仅用于分组与日志，不影响执行。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ViewType" mixed="true">
    <xs:annotation>
      <xs:documentation>视图：提供 &lt;select&gt; 时按方言结构化生成；只给 &lt;sql dialect&gt; 或 dialect 属性 + 节点内文本时原样透传；action=DROP 可只写 name。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="select" type="NonEmptyString">
        <xs:annotation>
          <xs:documentation>视图查询语句（不含 CREATE VIEW 前缀），例如 SELECT id, name FROM nor_user；不能为空（纯空白也算空）。</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sql" type="DialectSqlType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>视图名（必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>动作，缺省 ADD（各生成 CREATE OR REPLACE / CREATE OR ALTER）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="select" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>兼容写法：也可用 select 属性代替 &lt;select&gt; 子节点。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dialect" type="DialectName">
      <xs:annotation>
        <xs:documentation>直接写文本时的方言名（mysql / mariadb / postgresql / sqlserver / sqlite）；使用 &lt;select&gt; 或 &lt;sql&gt; 子节点时无需该属性。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>视图列名清单，逗号分隔（可选）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment" type="xs:string">
      <xs:annotation>
        <xs:documentation>视图注释（方言支持时使用）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="SequenceType">
    <xs:annotation>
      <xs:documentation>序列：PostgreSQL / SQL Server 原生支持；MySQL / SQLite 报 E046，请改用 &lt;rawSql&gt;。给 &lt;sql&gt; 子节点时按方言原样透传。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="sql" type="DialectSqlType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString" use="required">
      <xs:annotation>
        <xs:documentation>序列名（必填）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="action" type="ObjectAction" default="ADD">
      <xs:annotation>
        <xs:documentation>动作，缺省 ADD。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:long">
      <xs:annotation>
        <xs:documentation>起始值 START WITH。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="increment" type="IncrementValue">
      <xs:annotation>
        <xs:documentation>步长 INCREMENT BY：整数且不能为 0。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="minValue" type="xs:long">
      <xs:annotation>
        <xs:documentation>最小值 MINVALUE。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxValue" type="xs:long">
      <xs:annotation>
        <xs:documentation>最大值 MAXVALUE。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cycle" type="BooleanLiteral">
      <xs:annotation>
        <xs:documentation>是否循环 CYCLE。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cache" type="xs:positiveInteger">
      <xs:annotation>
        <xs:documentation>缓存个数 CACHE：正整数。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ScriptType" mixed="true">
    <xs:annotation>
      <xs:documentation>触发器 / 存储过程 / 函数：语法差异是结构性的，按方言写 &lt;sql dialect="..."&gt; 原样透传（也支持直接在节点内写文本 / CDATA）。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="sql" type="DialectSqlType" />
    </xs:choice>
    <xs:attribute name="name" type="NonEmptyString">
      <xs:annotation>
        <xs:documentation>对象名（用于日志与排序，可选）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dialect" type="DialectName">
      <xs:annotation>
        <xs:documentation>直接写文本时的方言名（mysql / mariadb / postgresql / sqlserver / sqlite）；使用 &lt;sql&gt; 子节点时无需该属性。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stage" type="Stage" default="after">
      <xs:annotation>
        <xs:documentation>执行时机：before / after（缺省）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="changeUnit">
    <xs:annotation>
      <xs:documentation>变更单元根节点。文件名必须是 {yyyyMMdd_HHmmss}.xml 或 {yyyyMMdd}.xml；id 必须与文件名前缀一致；release 必填。</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="description" type="xs:string">
          <xs:annotation>
            <xs:documentation>人类可读的变更说明。</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="depends" type="DependsType" />
        <xs:element name="table" type="TableType" />
        <xs:element name="rawSql" type="RawSqlType" />
        <xs:element name="view" type="ViewType" />
        <xs:element name="sequence" type="SequenceType" />
        <xs:element name="trigger" type="ScriptType" />
        <xs:element name="procedure" type="ScriptType" />
        <xs:element name="function" type="ScriptType" />
      </xs:choice>
      <xs:attribute name="id" type="ChangeId" use="required">
        <xs:annotation>
          <xs:documentation>变更单元 id（必填）：8 位日期开头，必须与文件名前缀一致。</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="author" type="NonEmptyString" use="required">
        <xs:annotation>
          <xs:documentation>变更作者（必填）。</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="release" type="Release" use="required">
        <xs:annotation>
          <xs:documentation>所属发布版本（必填）：yyyyMMdd；基线固定 00000000；不得晚于当前日期 + 1 天。</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="lateSubmission" type="BooleanLiteral">
        <xs:annotation>
          <xs:documentation>补丁标记：true 表示本单元是发布窗口之后补提交的补丁，只告警 W046；不写且配置未开启 allowLateSubmission 时报 E121。</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

</xs:schema>
