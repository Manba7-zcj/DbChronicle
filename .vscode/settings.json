    },
    {
      "pattern": "**/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.xml",
      "systemId": "${workspaceFolder}/Src/DbChronicle/Schema/DbChronicle.ChangeUnit.xsd"
    },
    {
      "pattern": "**/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].xml",
      "systemId": "${workspaceFolder}/Src/DbChronicle/Schema/DbChronicle.ChangeUnit.xsd"
